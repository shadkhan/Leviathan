{
  // The main-thread project: viewer UI, background service worker, protocol.
  // `src/worker` is excluded and has its own project — see src/worker/tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"]
  },
  "include": ["src/ui", "src/background", "src/protocol"]
}
